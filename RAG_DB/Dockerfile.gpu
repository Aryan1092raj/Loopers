# Content Studio (RAG) — GPU generation image.
#
# Identical in purpose to Dockerfile (the CPU image) but built on a CUDA base
# with the CUDA build of torch, so EmbeddingGemma 2 query embedding and the cross-encoder
# reranker run on the GPU. Like the CPU image it is generation-only: it does NOT
# do OCR/ingestion (no PaddleOCR), so it stays reliable in a container — the GPU
# is used purely for the embedding/rerank torch models.
#
# Requires on the host: an NVIDIA driver + the NVIDIA Container Toolkit, and
# `--gpus all` at run time (docker-compose.yml does this via the deploy block).
#
# IMPORTANT: match the CUDA tag + the torch wheel index to your host driver.
# Below targets CUDA 12.1 (driver >= 525). For an older driver, drop to e.g.
# nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04 and the cu118 torch index.
FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

# python + the same TeX Live set as the app (xelatex for the Beamer/notes PDFs)
# + libgomp1 (torch runtime) + curl/ca-certificates (healthcheck + LLM HTTPS).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip \
    curl ca-certificates libgomp1 \
    texlive-latex-base texlive-latex-recommended texlive-latex-extra \
    texlive-fonts-recommended texlive-science texlive-pictures \
    texlive-xetex fonts-noto-core fonts-texgyre \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/local/bin/python

WORKDIR /app

# CUDA torch FIRST, from the matching CUDA wheel index, so the FlagEmbedding
# sentence-transformers install below reuses it instead of pulling the CPU build.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu121

COPY requirements.docker.txt ./
RUN pip install --no-cache-dir -r requirements.docker.txt

# App code + templates + the prebuilt embedded vector corpus (config.ROOT = /app).
COPY src ./src
COPY templates ./templates
COPY qdrant_db ./qdrant_db

# Embedded Qdrant (baked corpus), no OCR, headless matplotlib, HF cache on the
# mounted volume, unbuffered logs. GPU is picked up automatically by torch when
# the container is started with the NVIDIA runtime.
ENV QDRANT_URL="" \
    USE_GPU_OCR=0 \
    MPLBACKEND=Agg \
    HF_HOME=/models \
    PYTHONUNBUFFERED=1 \
    LOOPERS_NO_REEXEC=1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
