{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Deck slide spec",
  "type": "object",
  "required": ["title", "slides"],
  "properties": {
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "query": {"type": "string"},
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["section", "bullets", "image", "diagram", "quote", "summary", "references",
                     "theorem", "derivation", "example", "definition", "tikz", "matplotlib",
                     "mermaid", "graphviz"]
          },
          "title": {"type": "string"},
          "number": {"type": "integer"},
          "bullets": {"type": "array", "items": {"type": "string"}},
          "image": {"type": "string"},
          "caption": {"type": "string"},
          "explains": {"type": "array", "items": {"type": "string"}},
          "text": {"type": "string"},
          "takeaways": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string"}},
          "source": {
            "type": "object",
            "properties": {
              "doc": {"type": "string"},
              "loc": {"type": "string"}
            }
          },
          "statement": {"type": "string"},
          "proof_sketch": {"type": "array", "items": {"type": "string"}},
          "corollary": {"type": "string"},
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {"type": "string"},
                "math": {"type": "string"},
                "note": {"type": "string"}
              },
              "required": ["label", "math", "note"]
            }
          },
          "result": {"type": "string"},
          "problem": {"type": "string"},
          "solution": {"type": "array", "items": {"type": "string"}},
          "answer": {"type": "string"},
          "term": {"type": "string"},
          "body": {"type": "string"},
          "notation": {"type": "string"},
          "code": {"type": "string"}
        }
      }
    }
  }
}
