# ── Preferred: native Anthropic (no proxy needed if you already have a key) ──
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6   # falls back to NOTES_MODEL if unset

# ── Alternative: Primary LLM via proxy (orchestrator / spec generation / labeling) ──
# Get key from https://agentrouter.org
AGENTROUTER_API_KEY=sk-or-v1-...
# AGENTROUTER_MODEL=gpt-5.5

# ── DeepSeek V4 Pro (primary generation LLM) ──
# Get key from https://platform.deepseek.com/api_keys
# OpenAI-compatible API at https://api.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional: enable reasoning/thinking mode (useful for chatbot/judge, NOT for strict JSON spec generation)
# Notes generation overrides this to "high" via call_llm_with_fallback(..., reasoning_effort="high")
# so deep derivations get the full reasoning budget. Leave this blank unless you want
# the default (chatbot / grading) role to also reason.
# DEEPSEEK_REASONING=high

# ── Required: Fallback / eval LLMs ──
# Get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# Get key from https://console.groq.com/keys  (comma-separated for round-robin)
GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_CONTENT_MODEL=llama-3.3-70b-versatile

# ── Optional: NVIDIA NIM (transcript processing / additional fallback) ──
# Get key from https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# ── Vector store ──
# COLLECTION=multimodal_hackathon
# EMBED_MODEL=google/embeddinggemma-2   # needs transformers>=5; BAAI/bge-m3 needs its own env (FlagEmbedding)
QDRANT_URL=http://localhost:6333   # unset = embedded mode (single-process)
# QDRANT_API_KEY=

# ── Pipeline feature toggles ──
# CLAF_TAGGING=0
# KG_EXTRACTION=0
# CHUNK_WORDS=350
# SCORE_THRESHOLD=0.3

# ── Slide theme (cream / dark / light) ──
# SLIDE_THEME=cream

# ── OCR engine ──
# OCR_ENGINE=paddle
# USE_GPU_OCR=0

# ── GLM-OCR (experimental) ──
# GLM_OCR_MODE=local
# GLM_OCR_API_URL=http://localhost:11434/v1
# GLM_OCR_API_KEY=EMPTY
# GLM_OCR_MODEL=zai-org/GLM-OCR

# ── Primary LLM (OpenAI / GPT) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.5-preview
# Optional: set to use a proxy (e.g. GLM proxy URL)
# OPENAI_BASE_URL=https://your-proxy.example.com/v1
