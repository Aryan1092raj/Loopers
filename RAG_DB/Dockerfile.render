# Loopers API for Render: no models, demo course baked in, vectors in Qdrant Cloud.
# Models run on a separate GPU service (Google Cloud); this image only calls it.
# Render builds it from GitHub (render.yaml) with RAG_DB as the context, so deploy_data/ must be committed.
#   bash export_deploy_data.sh && docker build -f Dockerfile.render -t loopers-api .
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY requirements.render.txt ./
RUN pip install --no-cache-dir -r requirements.render.txt

COPY src ./src
COPY templates ./templates
# ponytail: SQLite and media live in the image, so learner progress resets on every deploy or restart.
# Move course.db to a hosted database when progress has to persist.
# ponytail: deploy_dat[a] glob + requirements file keep the build green when deploy_data/ is not committed (Qdrant-only).
COPY requirements.render.txt deploy_dat[a]/ ./

ENV LOOPERS_NO_REEXEC=1 \
    MEDIA_DIR=/app/processed/media \
    MPLBACKEND=Agg \
    PYTHONUNBUFFERED=1

# Render sets PORT.
CMD ["sh", "-c", "uvicorn api.main:app --app-dir src --host 0.0.0.0 --port ${PORT:-8000}"]
