# Ignore temporary SQLite files
*.db-shm
*.db-wal

# Ignore untracked processing directories
processed/
raw/
metadata/
qdrant_db/

# Local docs: every .md stays on disk only, except README files
*.md
!README.md

# Python caches
__pycache__/
*.pyc
.venv/

# Foreign secret, never track
RAG_DB/brain.config.json
.agents/
.claude/
skills-lock.json